# --- idf.py (main controller) build outputs — regenerated from source ---
idf/build/
idf/build_nodebug/
idf/build_bootloader_update/
idf/.cache/
idf/managed_components/
idf/sdkconfig
# idf/sdkconfig.defaults and idf/dependencies.lock ARE tracked — the first
# is the real, versioned config source; the second pins component versions
# (see CLAUDE.md's idf.py-build-details section for why both stay).

# --- archived builds/crashes (regenerated by compile.sh/decode_crash.sh) ---
/build_archive/
/crash_archive/
.coredump_venv/

# --- display/ (arduino-cli) build outputs ---
display/build/
display/build_archive/

# --- graphify knowledge-graph cache (regenerated by `graphify update .`) ---
graphify-out/

# --- local MQTT test broker runtime state ---
mqtt/mosquitto/mosquitto.db
mqtt/mosquitto/mosquitto.pid
mqtt/mosquitto/*.log

# --- personal Claude Code tooling, not part of the project itself ---
.claude/settings.local.json
.claude/scheduled_tasks.lock
claude.sh

# --- editor/OS cruft ---
.DS_Store
*.swp
